{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Thread Kanban",
  "version": "0.1.0",
  "identifier": "local.codex.thread-kanban",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../src-ui/dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.build/browser/agent-browser": "browser/agent-browser",
      "../scripts/session_browser.mjs": "browser/session_browser.mjs",
      "../scripts/session_browser_core.mjs": "browser/session_browser_core.mjs",
      "../scripts/session_browser_probe/runtime.json": "browser/session_browser_probe/runtime.json",
      "../scripts/session_browser_probe/prepare.py": "browser/session_browser_probe/prepare.py",
      "../scripts/session_browser_probe/oci_cache.py": "browser/session_browser_probe/oci_cache.py",
      "../scripts/session_browser_cdp.mjs": "browser/session_browser_cdp.mjs"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Codex Thread Kanban",
        "width": 1320,
        "height": 820,
        "minWidth": 360,
        "minHeight": 680,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 10
        }
      }
    ]
  }
}
