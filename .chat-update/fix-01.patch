@@ -2365,4 +2372,56 @@ for line in sys.stdin:
         assert_eq!(inspected.task.revision, completed.task.revision);
         assert_eq!(inspected.runs.len(), completed.runs.len());
     }
+
+    #[test]
+    #[cfg(unix)]
+    fn service_manual_chats_and_extraction_keep_task_and_source_identity() {
+        let fixture = ServiceFixture::new();
+        let project = fixture.service.call("chat/project", json!({
+            "name":"Fixture project","path":fixture.directory.to_string_lossy()
+        })).unwrap();
+        let task = fixture.service.call("chat/create_task", json!({
+            "title":"Discuss a plan","project_id":project["id"]
+        })).unwrap();
+        let tid = task["task_id"].as_str().unwrap();
+        let first = fixture.service.call("chat/create_conversation", json!({"task_id":tid})).unwrap();
+        let second = fixture.service.call("chat/create_conversation", json!({"task_id":tid})).unwrap();
+        let cid = first["id"].as_str().unwrap();
+        fixture.service.call("chat/send", json!({
+            "conversation_id":cid,"text":"Discuss only, do not change files","attachments":[],"include_context":true
+        })).unwrap();
+        let started=std::time::Instant::now();
+        let source_thread = loop {
+            let detail=fixture.service.call("chat/detail",json!({"conversation_id":cid})).unwrap();
+            if detail["conversation"]["runtime_status"]=="idle" && detail["runs"].as_array().is_some_and(|runs|!runs.is_empty()) {
+                break detail["conversation"]["thread_id"].clone();
+            }
+            assert!(started.elapsed()<std::time::Duration::from_secs(10),"manual chat did not finish: {detail}");
+            std::thread::sleep(std::time::Duration::from_millis(20));
+        };
+        let extraction=fixture.service.call("chat/extract",json!({"conversation_id":cid})).unwrap();
+        let result_id=extraction["result_id"].as_str().unwrap();
+        let started=std::time::Instant::now();
+        loop {
+            let snapshot=fixture.service.call("chat/snapshot",json!({})).unwrap();
+            let task=&snapshot["tasks"][0];
+            if let Some(result)=task["results"].as_array().unwrap().iter().find(|r|r["id"]==result_id&&r["status"]=="ready") {
+                assert_eq!(result["conversation_id"],cid);
+                assert_eq!(result["method"],"manual");
+                assert_eq!(result["usable"],false);
+                assert!(result["markdown"].as_str().unwrap().contains("plan"));
+                assert_ne!(task["status"],"completed");
+                assert_eq!(snapshot["tasks"].as_array().unwrap().len(),1);
+                assert_eq!(snapshot["conversations"].as_array().unwrap().len(),2);
+                break;
+            }
+            assert!(started.elapsed()<std::time::Duration::from_secs(10),"summary did not finish: {snapshot}");
+            std::thread::sleep(std::time::Duration::from_millis(20));
+        }
+        let first=fixture.service.call("chat/detail",json!({"conversation_id":cid})).unwrap();
+        assert_eq!(first["conversation"]["thread_id"],source_thread);
+        let untouched=fixture.service.call("chat/detail",json!({"conversation_id":second["id"]})).unwrap();
+        assert!(untouched["conversation"]["thread_id"].is_null());
+        assert!(fixture.service.call("chat/extract",json!({"conversation_id":cid})).is_err());
+    }
 }
